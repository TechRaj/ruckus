# The proxy reads these. Never ship a key in the app binary (CLAUDE.md §5.5).
OPENROUTER_API_KEY=sk-or-...

# Optional. Swapping models for an accuracy comparison is an env var:
#   anthropic/claude-haiku-4.5    $1.00 / $5.00 per 1M   <- current default
#   google/gemini-3.7-flash       $0.75 / $3.75
#   anthropic/claude-sonnet-4.6   $3.00 / $15.00
# MODEL=anthropic/claude-haiku-4.5
# MAX_TOKENS=4000
# PORT=3000

# Figma personal access token, for `npm run design`.
# Figma -> avatar -> Settings -> Security -> Personal access tokens
# Free on every plan, including Starter. Scope: File content -> read.
FIGMA_TOKEN=figd_...        # FIGMA_API_KEY also accepted

# Google Places API (New). Needs a Cloud project with billing enabled.
# Restrict the key to the Places API only. It lives here, never in the app.
GOOGLE_PLACES_API_KEY=AIza...

# Emergency overrides for the two regexes that break when Instagram changes
# og:description (§5.4). Served by GET /config; the app applies them at launch.
# WRAPPER_RE=
# PROFILE_NAME_RE=
# CONFIG_UPDATED_AT=

# Requests per minute per IP on the proxy. 20 is right for a phone; batch
# tooling over the whole corpus needs more.
# RATE_MAX=20

# Supabase. The anon key is public and goes in the app; the service role key
# bypasses every security rule and must only ever live on the server.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# For `npm run db:push`: dashboard -> Connect -> Session pooler URI
SUPABASE_DB_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# RevenueCat public SDK key (test_ for the Test Store, appl_ for the App Store)
REVENUE_CAT_API_KEY=
# Exact Authorization header value typed into RevenueCat's webhook settings
REVENUECAT_WEBHOOK_AUTH="Bearer <random>"

# Lets our own tooling (harness, e2e) call the proxy. The app never uses it -
# it sends the signed-in user's Supabase token instead.
PROXY_SECRET=

# --- the app (apps/mobile/.env is a link to this file, made on first start) ---
# Only EXPO_PUBLIC_* is built into the app, and anyone who downloads it can
# read those values. Never give a secret this prefix.
EXPO_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
EXPO_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
EXPO_PUBLIC_PROXY_URL=https://ruckus-production-1747.up.railway.app
EXPO_PUBLIC_REVENUECAT_KEY=
